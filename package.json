{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "setup-network": "node setup-network.cjs",
        "start-ngrok": "node start-ngrok.cjs",
        "start-local": "npm run setup-network && dotenv -e .env concurrently \"%PHP_PATH% artisan serve --host=%HOST% --port=%PORT%\" \"npm run start-ngrok\" \"npm run dev\" \"%PHP_PATH% artisan queue:work\""
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "autoprefixer": "^10.4.20",
        "axios": "^1.6.4",
        "concurrently": "^9.1.0",
        "dotenv-cli": "^7.4.4",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.5.1",
        "postcss-nesting": "^13.0.1",
        "tailwindcss": "^3.4.17",
        "vite": "^5.0.0"
    },
    "dependencies": {
        "flowbite": "^2.5.2",
        "ngrok": "^5.0.0-beta.2",
        "pusher-js": "^8.4.0-rc2",
        "qrcode-terminal": "^0.12.0"
    }
}
